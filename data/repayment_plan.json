  "calculation_rules": {
    "rule_1": "每阶段结算日当天结束时自动触发还款判定",
    "rule_2": "玩家可以主动提前还款，但阶段判定日仍会检查该阶段最低还款额是否满足",
    "rule_3": "若实际还款 >= 最低还款额：总债务 -= 实际还款",
    "rule_4": "若实际还款 < 最低还款额：未还部分 = 最低还款额 - 实际还款；利息 = 未还部分 × 0.25；总债务 = 总债务 - 实际还款 + 利息",
    "rule_5": "提前还款超出最低还款额的部分直接减少总债务，不产生额外收益或惩罚",
    "rule_6": "第100天必须还清全部剩余债务，任何未清债务均导致游戏失败"
  },
